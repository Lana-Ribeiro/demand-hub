        { "from": "READY_FOR_DEVELOPMENT", "to": "IN_DEVELOPMENT", "action": "START_EXECUTION", "label": "Iniciar execução", "permission": "EXECUTION_MANAGE", "forward": true },
        { "from": "IN_DEVELOPMENT", "to": "DOCUMENTATION", "action": "ADVANCE", "label": "Avançar para documentação", "permission": "DEMAND_TRANSITION", "forward": true },
        { "from": "DOCUMENTATION", "to": "COMPLETED", "action": "COMPLETE", "label": "Concluir demanda", "permission": "DEMAND_TRANSITION", "forward": true },
        { "from": "*", "to": "CANCELLED", "action": "CANCEL", "label": "Cancelar demanda", "permission": "DEMAND_TRIAGE", "requiresReason": true }
      ],
      "approvalRules": [
        { "stage": "EXECUTIVE_APPROVAL", "name": "Prioridade crítica (P1)", "role": "DIRECTOR", "field": "priority", "operator": "EQ", "value": "P1" },
        { "stage": "EXECUTIVE_APPROVAL", "name": "Orçamento estimado acima de R$ 500.000", "role": "DIRECTOR", "field": "estimatedBudget", "operator": "GT", "value": "500000" },
        { "stage": "EXECUTIVE_APPROVAL", "name": "Requisito regulatório", "role": "DIRECTOR", "field": "regulatoryRequirement", "operator": "EQ", "value": "true" },
        { "stage": "ARCHITECTURE_REVIEW", "name": "Aprovação de arquitetura", "role": "ARCHITECT" }
      ]
    },
