# =============================================================================
# Demand Hub — variáveis de ambiente (EXEMPLO). Copie para .env e preencha.
# NUNCA versione o arquivo .env nem credenciais reais.
# =============================================================================

# --- Aplicação -----------------------------------------------------------------
# dev = dados de exemplo + integrações MOCK; local = H2 sem Docker
SPRING_PROFILES_ACTIVE=dev,local
SERVER_PORT=8080
APP_PUBLIC_URL=http://localhost:4200
APP_CORS_ORIGINS=http://localhost:4200
# >= 32 caracteres; obrigatório no perfil prod
JWT_SECRET=
# senha dos usuários de desenvolvimento (somente perfil dev)
DEV_SEED_PASSWORD=

# --- Banco (PostgreSQL) ----------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/demandhub
DATABASE_USERNAME=demandhub
DATABASE_PASSWORD=

# --- Armazenamento de arquivos -------------------------------------------------
STORAGE_PATH=./data/storage
UPLOAD_MAX_SIZE_MB=25

# --- IA (anthropic | openai | azure-openai | mock) -----------------------------
AI_PROVIDER=mock
# anthropic: padrão claude-opus-5-5
AI_MODEL=
AI_API_KEY=
# azure-openai: https://<recurso>.openai.azure.com
AI_BASE_URL=
AI_AZURE_DEPLOYMENT=
AI_AZURE_API_VERSION=2024-06-01

# --- Jira PMO (real | mock | disabled) -----------------------------------------
JIRA_MODE=mock
JIRA_URL=https://sua-empresa.atlassian.net
JIRA_PROJECT=PMO
JIRA_ISSUE_TYPE=Task
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
JIRA_PRIORITY_MAP=P1:Highest,P2:High,P3:Medium,P4:Low

# --- Repositório de código da execução técnica (gitlab | github) ----------------
SCM_PROVIDER=gitlab

# --- GitHub (real | mock | disabled) — usado quando SCM_PROVIDER=github ----------
GITHUB_MODE=mock
GITHUB_API_URL=https://api.github.com
# token fine-grained com permissão Issues: read/write (ou clássico com escopo repo)
GITHUB_TOKEN=
# owner/repositorio padrão (cada projeto pode definir o seu)
GITHUB_REPOSITORY=
GITHUB_WEBHOOK_SECRET=
# Board do GitHub Projects (opcional). Token precisa também da permissão de Projects.
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
# intervalo de leitura do board (boards pessoais não enviam webhook)
GITHUB_PROJECT_POLL_INTERVAL=PT1M

# --- GitLab (real | mock | disabled) — usado quando SCM_PROVIDER=gitlab ----------
GITLAB_MODE=mock
GITLAB_URL=https://gitlab.sua-empresa.com
GITLAB_TOKEN=
GITLAB_DEFAULT_PROJECT_ID=
GITLAB_WEBHOOK_SECRET=

# --- Notificações ----------------------------------------------------------------
# Outlook/Exchange via SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

# --- Dashboard -------------------------------------------------------------------
DASHBOARD_STALLED_DAYS=10
DASHBOARD_MIN_SAMPLE=1
