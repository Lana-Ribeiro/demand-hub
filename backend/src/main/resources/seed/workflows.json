        { "from": "PMO_TRIAGE", "to": "INFO_REQUESTED", "action": "REQUEST_INFO", "label": "Solicitar informação", "permission": "DEMAND_TRIAGE" },
        { "from": "INFO_REQUESTED", "to": "PMO_TRIAGE", "action": "INFO_PROVIDED", "label": "Informações fornecidas", "forward": true, "systemOnly": true },
        { "from": "PMO_TRIAGE", "to": "EXECUTIVE_APPROVAL", "action": "APPROVE", "label": "Aprovar (PMO)", "permission": "DEMAND_TRIAGE", "forward": true },
        { "from": "PMO_TRIAGE,EXECUTIVE_APPROVAL", "to": "REJECTED", "action": "REJECT", "label": "Rejeitar", "permission": "DEMAND_TRIAGE", "requiresReason": true },
